<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>{{basics.name}} - Resume</title>
  <style>
    {{> baseStyles}}
    body {
      --accent: {{accentColor}};
      --subtitle-weight: {{subtitleWeight}};
      --subtitle-style: {{subtitleFontStyle}};
      font-family: {{fontFamily}}, 'Helvetica Neue', Arial, sans-serif;
      color: #1f2937;
      margin: 0;
      font-size: {{fontSize}}px;
      line-height: 1.5;
    }
    header {
      background: #111111;
      color: #fff;
      padding: 28px 40px;
    }
    h1 { font-size: 21px; margin: 0 0 2px; font-weight: 700; }
    h1.uppercase { text-transform: uppercase; }
    .label { font-size: 12px; color: #d1d5db; margin: 0 0 10px; }
    .contact { font-size: 9.5px; color: #d1d5db; }
    .contact span { margin-right: 12px; }
    .photo { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; float: right; border: 2px solid rgba(255,255,255,0.3); }
    .photo.photo-square { border-radius: 8px; }
    .body { padding: 24px 40px; }
    .columns { display: flex; gap: 28px; }
    .column { flex: 1; min-width: 0; }
    section { margin-bottom: 14px; }
    h2 {
      font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em;
      color: #111111; border-bottom: 2px solid var(--accent); padding-bottom: 3px; margin: 0 0 8px;
    }
    .item-title { font-weight: 700; font-size: 11px; }
    .item-subtitle { font-size: 10px; }
    .item-dates { float: right; font-size: 9.5px; color: #6b7280; }
    .tags span { background: #f3f4f6; color: #111111; }
    .skill-tags { display: flex; flex-wrap: wrap; gap: 4px 12px; }
    .icon-avatar { background: #f3f4f6; color: #374151; }
  </style>
</head>
<body>
  <header>
    {{#unless picture.hidden}}{{#if picture.url}}
      <img class="photo {{#if (eq profileSettings.photoStyle "square")}}photo-square{{/if}}" src="{{picture.url}}" />
    {{/if}}{{/unless}}
    <h1 class="{{#if profileSettings.uppercaseName}}uppercase{{/if}}">{{basics.name}}</h1>
    {{#if profileSettings.showHeadline}}<p class="label">{{basics.headline}}</p>{{/if}}
    <p class="contact">
      {{#if profileSettings.showEmail}}{{#if basics.email}}<span>{{icon "email"}}{{basics.email}}</span>{{/if}}{{/if}}
      {{#if profileSettings.showPhone}}{{#if basics.phone}}<span>{{icon "phone"}}{{basics.phone}}</span>{{/if}}{{/if}}
      {{#if profileSettings.showWebsite}}{{#if basics.website.url}}<span>{{icon "link"}}{{basics.website.url}}</span>{{/if}}{{/if}}
      {{#if profileSettings.showLocation}}{{#if basics.location}}<span>{{icon "location"}}{{basics.location}}</span>{{/if}}{{/if}}
      {{#each basics.customFields}}{{#if text}}<span>{{text}}</span>{{/if}}{{/each}}
    </p>
  </header>
  <div class="body">
    {{#unless summary.hidden}}{{#if summary.content.length}}
    <section>
      <h2>{{icon "summary"}}{{summary.title}}</h2>
      {{{richText summary.content}}}
    </section>
    {{/if}}{{/unless}}
    <div class="columns">
      {{#each columns}}
        <div class="column">
          {{#each this}}{{> sectionsBody}}{{/each}}
        </div>
      {{/each}}
    </div>
  </div>
</body>
</html>
