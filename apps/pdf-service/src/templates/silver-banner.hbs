<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>{{basics.name}} - Resume</title>
  <style>
    {{> baseStyles}}
    body {
      --accent: {{accentColor}};
      --subtitle-weight: {{subtitleWeight}};
      --subtitle-style: {{subtitleFontStyle}};
      font-family: {{fontFamily}}, 'Helvetica Neue', Arial, sans-serif;
      color: #1f2937;
      margin: 0;
      padding: 32px 40px;
      font-size: {{fontSize}}px;
      line-height: 1.5;
    }
    header {
      display: flex; justify-content: space-between; align-items: flex-start;
      border-bottom: 2px solid #e5e7eb; padding-bottom: 14px; margin-bottom: 16px;
    }
    h1 { font-size: 19px; margin: 0 0 2px; font-weight: 700; }
    h1.uppercase { text-transform: uppercase; }
    .label { font-size: 11px; color: var(--accent); margin: 0; font-weight: 600; }
    .contact { font-size: 9.5px; color: #4b5563; text-align: right; }
    .contact div { margin-bottom: 3px; }
    section { margin-bottom: 14px; padding: 10px 14px; background: #f9fafb; border-radius: 6px; }
    section.plain { background: none; padding: 0; }
    h2 {
      font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.06em;
      color: #111827; margin: 0 0 8px; font-weight: 700;
    }
    .columns { display: flex; gap: 20px; }
    .column { flex: 1; min-width: 0; }
    .item-title { font-weight: 700; font-size: 11px; }
    .item-subtitle { font-size: 10px; }
    .item-dates { float: right; font-size: 9.5px; color: #6b7280; }
    .tags span { background: #e5e7eb; color: #374151; }
    .skill-tags { display: flex; flex-wrap: wrap; gap: 4px 10px; }
    .icon-avatar { background: #e5e7eb; color: #4b5563; }
  </style>
</head>
<body>
  <header>
    <div>
      <h1 class="{{#if profileSettings.uppercaseName}}uppercase{{/if}}">{{basics.name}}</h1>
      {{#if profileSettings.showHeadline}}<p class="label">{{basics.headline}}</p>{{/if}}
    </div>
    <div class="contact">
      {{#if profileSettings.showEmail}}{{#if basics.email}}<div>{{icon "email"}}{{basics.email}}</div>{{/if}}{{/if}}
      {{#if profileSettings.showPhone}}{{#if basics.phone}}<div>{{icon "phone"}}{{basics.phone}}</div>{{/if}}{{/if}}
      {{#if profileSettings.showLocation}}{{#if basics.location}}<div>{{icon "location"}}{{basics.location}}</div>{{/if}}{{/if}}
      {{#if profileSettings.showWebsite}}{{#if basics.website.url}}<div>{{icon "link"}}{{basics.website.url}}</div>{{/if}}{{/if}}
    </div>
  </header>
  {{#unless summary.hidden}}{{#if summary.content.length}}
  <section class="plain">
    <h2>{{icon "summary"}}{{summary.title}}</h2>
    {{{richText summary.content}}}
  </section>
  {{/if}}{{/unless}}
  <div class="columns">
    {{#each columns}}
      <div class="column">
        {{#each this}}{{> sectionsBody}}{{/each}}
      </div>
    {{/each}}
  </div>
</body>
</html>
