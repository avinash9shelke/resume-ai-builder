<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>{{basics.name}} - Resume</title>
  <style>
    {{> baseStyles}}
    body {
      --accent: {{accentColor}};
      --subtitle-weight: {{subtitleWeight}};
      --subtitle-style: {{subtitleFontStyle}};
      font-family: {{fontFamily}}, Georgia, 'Times New Roman', serif;
      color: #1c1917;
      margin: 0;
      padding: 36px 48px;
      font-size: {{fontSize}}px;
      line-height: 1.55;
    }
    header { text-align: center; margin-bottom: 18px; }
    h1 { font-size: 22px; margin: 0 0 4px; font-weight: 400; letter-spacing: 0.02em; }
    h1.uppercase { text-transform: uppercase; }
    .label { font-size: 12px; color: #57534e; margin: 0 0 8px; font-style: italic; }
    .contact { font-size: 10px; color: #57534e; }
    .contact span:not(:last-child)::after { content: "\00a0\2022\00a0"; }
    header .rule { width: 70px; height: 1px; background: #a8a29e; margin: 12px auto 0; }
    section { margin-bottom: 15px; }
    h2 {
      font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.1em;
      color: #1c1917; border-bottom: 1px solid #d6d3d1; padding-bottom: 3px; margin: 0 0 8px; font-weight: 400;
    }
    .item-title { font-weight: 700; font-size: 11px; }
    .item-subtitle { font-size: 10.5px; font-style: italic; }
    .item-dates { float: right; color: #78716c; font-size: 10px; }
    .tags span { border: 1px solid #d6d3d1; color: #1c1917; }
    .skill-tags { display: flex; flex-wrap: wrap; gap: 4px 14px; }
    .icon-avatar { background: #f5f5f4; color: #57534e; }
  </style>
</head>
<body>
  <header>
    <h1 class="{{#if profileSettings.uppercaseName}}uppercase{{/if}}">{{basics.name}}</h1>
    {{#if profileSettings.showHeadline}}<p class="label">{{basics.headline}}</p>{{/if}}
    <p class="contact">
      {{#if profileSettings.showLocation}}{{#if basics.location}}<span>{{icon "location"}}{{basics.location}}</span>{{/if}}{{/if}}
      {{#if profileSettings.showEmail}}{{#if basics.email}}<span>{{icon "email"}}{{basics.email}}</span>{{/if}}{{/if}}
      {{#if profileSettings.showPhone}}{{#if basics.phone}}<span>{{icon "phone"}}{{basics.phone}}</span>{{/if}}{{/if}}
      {{#if profileSettings.showWebsite}}{{#if basics.website.url}}<span>{{icon "link"}}{{basics.website.url}}</span>{{/if}}{{/if}}
    </p>
    <div class="rule"></div>
  </header>

  {{#unless summary.hidden}}{{#if summary.content.length}}
  <section>
    <h2>{{icon "summary"}}{{summary.title}}</h2>
    {{{richText summary.content}}}
  </section>
  {{/if}}{{/unless}}
  <div class="columns" style="display:flex; gap: 26px;">
    {{#each columns}}
      <div class="column" style="flex:1; min-width:0;">
        {{#each this}}{{> sectionsBody}}{{/each}}
      </div>
    {{/each}}
  </div>
</body>
</html>
