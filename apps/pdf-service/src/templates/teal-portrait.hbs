<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>{{basics.name}} - Resume</title>
  <style>
    {{> baseStyles}}
    body {
      --accent: {{accentColor}};
      --subtitle-weight: {{subtitleWeight}};
      --subtitle-style: {{subtitleFontStyle}};
      font-family: {{fontFamily}}, 'Helvetica Neue', Arial, sans-serif;
      color: #1f2937;
      margin: 0;
      font-size: {{fontSize}}px;
      line-height: 1.5;
    }
    .page { display: flex; min-height: 100vh; }
    .sidebar {
      flex: 0 0 34%;
      background: var(--accent);
      color: #f0fdfa;
      padding: 28px 22px;
      text-align: center;
    }
    .photo { width: 76px; height: 76px; border-radius: 50%; object-fit: cover; margin: 0 auto 16px; display: block; border: 3px solid rgba(255,255,255,0.5); }
    .photo.photo-square { border-radius: 12px; }
    .sidebar section { text-align: left; }
    .main { flex: 1; min-width: 0; padding: 28px 30px; }
    h1 { font-size: 18px; margin: 0 0 2px; font-weight: 700; }
    h1.uppercase { text-transform: uppercase; }
    .label { font-size: 11px; color: var(--accent); margin: 0 0 8px; font-weight: 600; }
    .contact { font-size: 9.5px; color: #4b5563; margin-bottom: 14px; }
    .contact div { margin-bottom: 4px; }
    section { margin-bottom: 14px; }
    .sidebar h2 { color: #fff; border-bottom-color: rgba(255,255,255,0.3); text-align: left; }
    .main h2 { color: var(--accent); border-bottom: 1px solid #e5e7eb; }
    h2 {
      font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.06em;
      margin: 0 0 8px; font-weight: 700; padding-bottom: 4px;
    }
    .sidebar .item-title, .sidebar .item-subtitle, .sidebar .item-dates { color: #f0fdfa; }
    .sidebar .skill-tag, .sidebar .tags span { background: rgba(255,255,255,0.15); color: #f0fdfa; }
    .sidebar .icon-avatar { background: rgba(255,255,255,0.15); color: #f0fdfa; }
    .sidebar .achievement-item { border: none; padding: 0; }
    .sidebar .level-dots .level-dot { background: rgba(255,255,255,0.35); }
    .sidebar .level-dots .level-dot.filled { background: #fff; }
    .main .item-title { font-weight: 700; font-size: 11px; }
    .main .item-subtitle { font-size: 10px; }
    .item-dates { float: right; font-size: 9.5px; color: #6b7280; }
    .skill-tags { display: flex; flex-wrap: wrap; gap: 4px 10px; }
    .level-dots { display: inline-flex; }
  </style>
</head>
<body>
  <div class="page">
    <aside class="sidebar">
      {{#unless picture.hidden}}{{#if picture.url}}
        <img class="photo {{#if (eq profileSettings.photoStyle "square")}}photo-square{{/if}}" src="{{picture.url}}" />
      {{/if}}{{/unless}}
      {{#each columns.[0]}}{{> sectionsBody}}{{/each}}
    </aside>
    <main class="main">
      <h1 class="{{#if profileSettings.uppercaseName}}uppercase{{/if}}">{{basics.name}}</h1>
      {{#if profileSettings.showHeadline}}<p class="label">{{basics.headline}}</p>{{/if}}
      <div class="contact">
        {{#if profileSettings.showPhone}}{{#if basics.phone}}<div>{{icon "phone"}}{{basics.phone}}</div>{{/if}}{{/if}}
        {{#if profileSettings.showEmail}}{{#if basics.email}}<div>{{icon "email"}}{{basics.email}}</div>{{/if}}{{/if}}
        {{#if profileSettings.showWebsite}}{{#if basics.website.url}}<div>{{icon "link"}}{{basics.website.url}}</div>{{/if}}{{/if}}
        {{#if profileSettings.showLocation}}{{#if basics.location}}<div>{{icon "location"}}{{basics.location}}</div>{{/if}}{{/if}}
      </div>
      {{#unless summary.hidden}}{{#if summary.content.length}}
      <section>
        <h2>{{icon "summary"}}{{summary.title}}</h2>
        {{{richText summary.content}}}
      </section>
      {{/if}}{{/unless}}
      {{#each columns.[1]}}{{> sectionsBody}}{{/each}}
    </main>
  </div>
</body>
</html>
