{{#if (eq kind "experience")}}
  {{#if @root.sections.experience.items.length}}
  <section>
    <h2>{{icon "experience"}}{{@root.sections.experience.title}}</h2>
    {{#each @root.sections.experience.items}}
      {{#if logo}}
      <div class="icon-item">
        <img class="item-logo" src="{{logo}}" />
        <div>
          {{#if period}}<span class="item-dates">{{period}}</span>{{/if}}
          <div class="item-title">{{position}}</div>
          <div class="item-subtitle">{{company}}{{#if location}}, {{location}}{{/if}}</div>
          {{#if description.length}}{{{richText description}}}{{/if}}
        </div>
      </div>
      {{else}}
      <div class="item">
        {{#if period}}<span class="item-dates">{{period}}</span>{{/if}}
        <div class="item-title">{{position}}</div>
        <div class="item-subtitle">{{company}}{{#if location}}, {{location}}{{/if}}</div>
        {{#if description.length}}{{{richText description}}}{{/if}}
      </div>
      {{/if}}
    {{/each}}
  </section>
  {{/if}}
{{/if}}
{{#if (eq kind "education")}}
  {{#if @root.sections.education.items.length}}
  <section>
    <h2>{{icon "education"}}{{@root.sections.education.title}}</h2>
    {{#each @root.sections.education.items}}
      <div class="item">
        {{#if period}}<span class="item-dates">{{period}}</span>{{/if}}
        <div class="item-title">{{school}}</div>
        <div class="item-subtitle">{{degree}} {{area}}</div>
        {{#if grade}}<p>Grade: {{grade}}</p>{{/if}}
      </div>
    {{/each}}
  </section>
  {{/if}}
{{/if}}
