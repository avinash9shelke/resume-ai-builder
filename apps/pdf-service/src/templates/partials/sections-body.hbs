{{#if (eq kind "custom")}}
  <section>
    <h2>{{custom.title}}</h2>
    {{#each custom.items}}
      <div class="icon-item">
        {{#if ../custom.icon}}<span class="icon-avatar">&#9670;</span>{{/if}}
        <div>
          {{#if ../custom.showDate}}<span class="item-dates">{{date}}</span>{{/if}}
          <div class="item-title">{{title}}</div>
          {{#if description.length}}{{{richText description}}}{{/if}}
        </div>
      </div>
    {{/each}}
  </section>
{{/if}}
