<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>{{basics.name}} - Resume</title>
  <style>
    {{> baseStyles}}
    body {
      --accent: {{accentColor}};
      --subtitle-weight: {{subtitleWeight}};
      --subtitle-style: {{subtitleFontStyle}};
      font-family: {{fontFamily}}, 'Helvetica Neue', Arial, sans-serif;
      color: #1f2937;
      margin: 0;
      padding: 32px 40px;
      font-size: {{fontSize}}px;
      line-height: 1.5;
    }
    header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 18px; }
    .photo { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; }
    .photo.photo-square { border-radius: 8px; }
    h1 { font-size: 20px; margin: 0 0 2px; font-weight: 700; }
    h1.uppercase { text-transform: uppercase; }
    .label { font-size: 12px; color: var(--accent); margin: 0 0 8px; font-weight: 600; }
    .contact { font-size: 9.5px; color: #4b5563; }
    .contact span { margin-right: 10px; }
    section { margin-bottom: 15px; }
    h2 {
      font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;
      color: #111827; border-bottom: 1px solid #e5e7eb; padding-bottom: 3px; margin: 0 0 8px;
    }
    .item-title { font-weight: 600; font-size: 11.5px; }
    .item-subtitle { font-size: 10.5px; }
    .item-dates { float: right; color: #6b7280; font-size: 10px; }
    .tags span { background: #f3f4f6; color: #374151; }
    .skill-tags { display: flex; flex-wrap: wrap; gap: 4px 14px; }
    .bottom-grid { display: flex; gap: 20px; }
    .bottom-grid .column { flex: 1; min-width: 0; }
    .icon-avatar { background: #f3f4f6; color: #6b7280; }
  </style>
</head>
<body>
  <header>
    <div>
      <h1 class="{{#if profileSettings.uppercaseName}}uppercase{{/if}}">{{basics.name}}</h1>
      {{#if profileSettings.showHeadline}}<p class="label">{{basics.headline}}</p>{{/if}}
      <p class="contact">
        {{#if profileSettings.showEmail}}{{#if basics.email}}<span>{{icon "email"}}{{basics.email}}</span>{{/if}}{{/if}}
        {{#if profileSettings.showPhone}}{{#if basics.phone}}<span>{{icon "phone"}}{{basics.phone}}</span>{{/if}}{{/if}}
        {{#if profileSettings.showLocation}}{{#if basics.location}}<span>{{icon "location"}}{{basics.location}}</span>{{/if}}{{/if}}
      </p>
    </div>
    {{#unless picture.hidden}}{{#if picture.url}}
      <img class="photo {{#if (eq profileSettings.photoStyle "square")}}photo-square{{/if}}" src="{{picture.url}}" />
    {{/if}}{{/unless}}
  </header>

  {{#unless summary.hidden}}{{#if summary.content.length}}
  <section>
    <h2>{{icon "summary"}}{{summary.title}}</h2>
    {{{richText summary.content}}}
  </section>
  {{/if}}{{/unless}}
  <div class="bottom-grid">
    {{#each columns}}
      <div class="column">
        {{#each this}}{{> sectionsBody}}{{/each}}
      </div>
    {{/each}}
  </div>
</body>
</html>
